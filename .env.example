# Images are built locally from the source trees in this repository.
CPA_IMAGE=p4-cpa/cpa:local
CPAMP_IMAGE=p4-cpa/manager:local
COMPOSE_PROJECT_NAME=p4-cpa
# Set to this host's tailnet IPv4 address for direct private-network access.
BIND_IP=127.0.0.1
CPA_PORT=8317
CPAMP_PORT=18317
# Callback bindings stay local even when the API is exposed on the tailnet.
OAUTH_BIND_IP=127.0.0.1
OAUTH_GEMINI_PORT=8085
OAUTH_CODEX_PORT=1455
OAUTH_CLAUDE_PORT=54545
OAUTH_ANTIGRAVITY_PORT=51121
OAUTH_IFLOW_PORT=11451
# scripts/init.sh fills these with independent random keys.
CPA_MANAGEMENT_KEY=
CPAMP_ADMIN_KEY=
CPA_CLIENT_KEY=
